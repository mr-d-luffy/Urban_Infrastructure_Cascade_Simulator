# Urban Infrastructure Cascade Simulator - Mobile Environment Configuration Template

# Backend API Base URL
# - Android Emulator: http://10.0.2.2:5000
# - iOS Simulator / Web / Desktop: http://localhost:5000
# - Physical Mobile Device: http://192.168.1.XXX:5000 (replace with your machine IP)
API_BASE_URL=http://10.0.2.2:5000

# Default Simulation Configuration
DEFAULT_SIMULATION_DURATION=60
DEFAULT_TICK_SECONDS=1
DEFAULT_SEED=42003

# UI & Animation Settings
ENABLE_ANIMATIONS=true
PLAYBACK_SPEED_MS=700
