# Urban Infrastructure Cascade Simulator - Mobile Environment Configuration

# Backend API Base URL
# For Android Emulator: http://10.0.2.2:5000
# For iOS Simulator / Web / Desktop: http://localhost:5000
# For Physical Device: http://<YOUR_LOCAL_IP>:5000
API_BASE_URL=https://urban-infrastructure-cascade-simulator.onrender.com

# Default Simulation Settings
DEFAULT_SIMULATION_DURATION=60
DEFAULT_TICK_SECONDS=1
DEFAULT_SEED=42003

# UI & Animation Settings
ENABLE_ANIMATIONS=true
PLAYBACK_SPEED_MS=700
